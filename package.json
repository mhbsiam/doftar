{
  "name": "doftar",
  "private": true,
  "version": "1.0.0",
  "description": "A free, offline macOS file manager with tabs, split view and built-in viewers for code, data and notebooks.",
  "license": "Apache-2.0",
  "author": "Hasanul Banna Siam",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:visual": "vitest run -c vitest.visual.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "dmg": "bash scripts/build-dmg.sh",
    "notices": "node scripts/gen-notices.mjs",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
