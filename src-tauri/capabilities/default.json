{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main and tab windows. Files are opened through Doftar's own open_path / open_with commands, which refuse to run programs without confirmation; a previewed document's web and mail links go to the browser through open_web_link; the opener plugin may only open the one settings link and Doftar's GitHub and releases pages.",
  "windows": ["main", "tab-*"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-outer-size",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles" },
        { "url": "https://github.com/mhbsiam/doftar" },
        { "url": "https://github.com/mhbsiam/doftar/releases" }
      ]
    },
    "drag:default",
    "allow-list-dir",
    "allow-list-dir-stream",
    "allow-cancel-list-stream",
    "allow-list-dir-capped",
    "allow-request-folder-access",
    "allow-system-info",
    "allow-free-space",
    "allow-path-exists",
    "allow-is-folder",
    "allow-file-ids",
    "allow-item-ids",
    "allow-dir-stamp",
    "allow-git-info",
    "allow-git-overview",
    "allow-git-switch",
    "allow-git-worktree-status",
    "allow-git-repos",
    "allow-list-skills",
    "allow-create-skill",
    "allow-link-skill",
    "allow-compress-paths",
    "allow-extract-archive",
    "allow-copy-paths",
    "allow-find-conflicts",
    "allow-stat-entries",
    "allow-move-paths",
    "allow-transfer-paths",
    "allow-drop-moves",
    "allow-drop-plan",
    "allow-rename-path",
    "allow-rename-taken",
    "allow-create-dir",
    "allow-create-file",
    "allow-create-text-file",
    "allow-trash-paths",
    "allow-apply-steps",
    "allow-cancel-job",
    "allow-clipboard-write-files",
    "allow-clipboard-read-files",
    "allow-clipboard-change-count",
    "allow-clipboard-clear",
    "allow-clipboard-paste-data",
    "allow-archive-list",
    "allow-find-duplicates",
    "allow-pause-job",
    "allow-set-undo-labels",
    "allow-set-terminal-label",
    "allow-delete-permanently",
    "allow-open-terminal",
    "allow-run-in-terminal",
    "allow-item-info",
    "allow-folder-size",
    "allow-file-checksums",
    "allow-item-metadata",
    "allow-read-document",
    "allow-read-text",
    "allow-read-docx-text",
    "allow-media-info",
    "allow-cancel-size",
    "allow-disk-scan",
    "allow-cancel-disk-scan",
    "allow-disk-map",
    "allow-disk-map-forget",
    "allow-search-dir",
    "allow-search-tags",
    "allow-cancel-search",
    "allow-edit-tags",
    "allow-scan-tags",
    "allow-empty-trash",
    "allow-trash-dirs",
    "allow-ensure-dir",
    "allow-discard-asides",
    "allow-eject-volume",
    "allow-open-with-apps",
    "allow-open-with",
    "allow-open-path",
    "allow-open-link-target",
    "allow-reveal-in-finder",
    "allow-open-web-link",
    "allow-pick-application",
    "allow-terminal-apps",
    "allow-editor-apps",
    "allow-runs-as-program",
    "allow-thumbnail",
    "allow-thumbnail-cached",
    "allow-pdf-page-sizes",
    "allow-pdf-page-picture",
    "allow-cancel-thumbnail",
    "allow-cache-info",
    "allow-app-leftovers",
    "allow-delete-apps-with-admin",
    "allow-clear-cache",
    "allow-quicklook",
    "allow-quicklook-close",
    "allow-share-paths",
    "allow-open-tab-window",
    "allow-take-window-init",
    "allow-take-opened",
    "allow-tab-window-at",
    "allow-open-image-viewer",
    "allow-show-zoomed",
    "allow-motion-scale",
    "allow-log-ui-error",
    "allow-copy-diagnostics",
    "allow-viewer-return-rect",
    "allow-open-reader",
    "allow-is-text-file",
    "allow-open-pdf",
    "allow-open-video",
    "allow-resolve-alias",
    "allow-toggle-maximize-window",
    "allow-set-window-maximized",
    "allow-quit-app",
    "allow-watch-path",
    "allow-unwatch-path",
    "allow-download-file",
    "allow-watch-files",
    "allow-load-store",
    "allow-set-aside-store",
    "allow-save-store"
  ]
}
