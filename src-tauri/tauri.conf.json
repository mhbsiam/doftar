{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doftar",
  "mainBinaryName": "Doftar",
  "version": "1.0.0",
  "identifier": "com.doftar.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Doftar",
        "width": 1240,
        "height": 800,
        "minWidth": 760,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "center": true,
        "visible": false,
        "create": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; font-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CACHE/com.doftar.app/**",
          "$HOME/**/*.[pP][nN][gG]",
          "$HOME/**/*.[jJ][pP][gG]",
          "$HOME/**/*.[jJ][pP][eE][gG]",
          "$HOME/**/*.[gG][iI][fF]",
          "$HOME/**/*.[wW][eE][bB][pP]",
          "$HOME/**/*.[bB][mM][pP]",
          "$HOME/**/*.[sS][vV][gG]",
          "$HOME/**/*.[iI][cC][oO]",
          "$HOME/**/*.[aA][vV][iI][fF]",
          "$HOME/**/*.[tT][iI][fF]",
          "$HOME/**/*.[tT][iI][fF][fF]",
          "$HOME/**/*.[hH][eE][iI][cC]",
          "$HOME/**/*.[hH][eE][iI][fF]",
          "$HOME/**/*.[mM][pP][44]",
          "$HOME/**/*.[mM][44][vV]",
          "$HOME/**/*.[mM][oO][vV]",
          "$HOME/**/*.[wW][eE][bB][mM]",
          "$HOME/**/*.[mM][pP]3",
          "$HOME/**/*.[mM]4[aA]",
          "$HOME/**/*.[aA][aA][cC]",
          "$HOME/**/*.[wW][aA][vV]",
          "$HOME/**/*.[fF][lL][aA][cC]",
          "$HOME/**/*.[aA][iI][fF]",
          "$HOME/**/*.[aA][iI][fF][fF]",
          "/Volumes/**/*.[pP][nN][gG]",
          "/Volumes/**/*.[jJ][pP][gG]",
          "/Volumes/**/*.[jJ][pP][eE][gG]",
          "/Volumes/**/*.[gG][iI][fF]",
          "/Volumes/**/*.[wW][eE][bB][pP]",
          "/Volumes/**/*.[bB][mM][pP]",
          "/Volumes/**/*.[sS][vV][gG]",
          "/Volumes/**/*.[iI][cC][oO]",
          "/Volumes/**/*.[aA][vV][iI][fF]",
          "/Volumes/**/*.[tT][iI][fF]",
          "/Volumes/**/*.[tT][iI][fF][fF]",
          "/Volumes/**/*.[hH][eE][iI][cC]",
          "/Volumes/**/*.[hH][eE][iI][fF]",
          "/Volumes/**/*.[mM][pP][44]",
          "/Volumes/**/*.[mM][44][vV]",
          "/Volumes/**/*.[mM][oO][vV]",
          "/Volumes/**/*.[wW][eE][bB][mM]",
          "/Volumes/**/*.[mM][pP]3",
          "/Volumes/**/*.[mM]4[aA]",
          "/Volumes/**/*.[aA][aA][cC]",
          "/Volumes/**/*.[wW][aA][vV]",
          "/Volumes/**/*.[fF][lL][aA][cC]",
          "/Volumes/**/*.[aA][iI][fF]",
          "/Volumes/**/*.[aA][iI][fF][fF]"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "13.1",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "copyright": "Copyright (c) 2026 Hasanul Banna Siam. Licensed under the Apache License 2.0.",
    "shortDescription": "A free, offline macOS file manager with tabs, split view and built-in viewers for code, data and notebooks.",
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../TERMS.md": "TERMS.md",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
